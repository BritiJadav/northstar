# NorthStar General Insurance - Environment Configuration
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# AI Gateway / Vertex AI Configuration (Mandatory India Region)
GCP_PROJECT_ID=northstar-insurance-prod
GCP_REGION=asia-south1
GEMINI_MODEL=gemini-1.5-flash
AI_GATEWAY_ENDPOINT=https://asia-south1-aiplatform.googleapis.com/v1

# Security & Governance
ENABLE_PROMPT_INJECTION_SCAN=true
ENABLE_DPDP_PII_MASKING=true
STRICT_APPETITE_TRIAGE=true

# Storage & DB
SQLITE_DB_PATH=./data/northstar_audit.db
SHAREPOINT_SIMULATION_DIR=./data/sharepoint_storage
